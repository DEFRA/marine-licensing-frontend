{
  "name": "marine-licensing-frontend",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "NODE_ENV=production webpack",
    "dev": "run-p frontend:watch server:watch",
    "dev:debug": "run-p frontend:watch server:debug",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "frontend:watch": "NODE_ENV=development webpack --watch",
    "lint": "run-s lint:js lint:scss",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint .",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "postversion": "git add package.json package-lock.json && git commit -m $npm_package_version",
    "test": "TZ=UTC vitest run --coverage",
    "test:ml": "TZ=UTC vitest run --config vitest.marine-licence.config.js",
    "test:ci": "CI=true TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:watch:ml": "TZ=UTC vitest --config vitest.marine-licence.config.js",
    "test:integration:allure": "npx vitest run tests/ --coverage=false && npx allure generate allure-results --single-file --clean --name marine-licensing-dom-testing-library-tests",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "prestart": "npm run build",
    "start": "NODE_ENV=production node --use-strict .",
    "iat": "node scripts/iat-query.js",
    "knip": "knip"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/hapi-secure-context": "^0.4.0",
    "@defra/hapi-tracing": "^1.29.0",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@hapi/basic": "^7.0.2",
    "@hapi/bell": "^13.1.0",
    "@hapi/catbox-memory": "^6.0.2",
    "@hapi/catbox-redis": "^7.0.2",
    "@hapi/cookie": "^12.0.1",
    "@hapi/crumb": "^9.0.1",
    "@hapi/hapi": "^21.4.9",
    "@hapi/inert": "^7.1.2",
    "@hapi/jwt": "^3.2.4",
    "@hapi/vision": "^7.0.3",
    "@hapi/wreck": "^18.1.2",
    "@hapi/yar": "^11.0.3",
    "@microsoft/clarity": "^1.0.2",
    "@ministryofjustice/frontend": "^9.0.0",
    "accessible-autocomplete": "3.0.1",
    "aws-embedded-metrics": "^4.2.1",
    "convict": "^6.2.5",
    "cssnano": "^8.0.2",
    "cssnano-preset-default": "^8.0.2",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "global-agent": "^3.0.0",
    "govuk-frontend": "^6.0.0",
    "hapi-pino": "^13.0.0",
    "hapi-pulse": "^4.0.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "lodash": "^4.18.1",
    "node-fetch": "^3.3.2",
    "nunjucks": "^3.2.4",
    "ol": "^10.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.1",
    "proj4": "^2.20.9",
    "rfc2047": "^4.0.1",
    "sanitize-html": "2.17.6",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/preset-env": "^8.0.2",
    "@faker-js/faker": "^10.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/runner": "^4.1.4",
    "@vitest/ui": "^4.1.10",
    "allure-commandline": "^2.43.0",
    "allure-vitest": "^3.6.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "cheerio": "^1.2.0",
