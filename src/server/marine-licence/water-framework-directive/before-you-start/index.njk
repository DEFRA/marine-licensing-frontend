{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "cancel-button/macro.njk" import appCancelButton %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <h2 class="govuk-heading-m">Before you start</h2>

      <p class="govuk-body">The Water Framework Directive (WFD) protects the quality of estuarine and coastal waters. Its aim is to make sure all water bodies reach or maintain 'good' status.</p>

      <p class="govuk-body">We'll ask you some questions to find out whether you need to provide a WFD assessment with your application. We'll ask you if:</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>your proposed works are within one nautical mile (1.85km) of the low water line, or in a tidal river or estuary - including the shore between low and high tide</li>
        <li>your activity is one of the types that does not require an assessment</li>
      </ul>

      <h3 class="govuk-heading-s">Excluded activities</h3>

      <p class="govuk-body">Some activities do not need a WFD assessment, even if the proposed works are within one nautical mile (1.85km) of the low water line, or in a tidal river or estuary - including the shore between low and high tide.</p>

      {% set excludedActivitiesHtml %}
        <p class="govuk-body">You do not need to provide a WFD assessment if your proposed works are limited to one of the following activities:</p>
        <ul class="govuk-list govuk-list--bullet">
          <li>maintaining pumps at pumping stations - providing you do this regularly, avoid low dissolved oxygen levels during maintenance and minimise silt movement when restarting</li>
          <li>removing blockages or obstacles, such as litter or debris, within 10 metres of an existing structure to maintain flow</li>
          <li>replacing or removing existing pipes, cables or services crossing over a water body - not including any new structure or supports, or new bed or bank reinforcement</li>
          <li>‘over water’ repair or replacement work, for example to bridge, pier or jetty surfaces - providing you minimise bank or bed disturbance</li>
        </ul>
      {% endset %}

      {{ govukDetails({
        summaryText: "Help with excluded activities",
        html: excludedActivitiesHtml
      }) }}

      <h3 class="govuk-heading-s">Previous WFD assessments</h3>

      <p class="govuk-body">You can provide a previous WFD assessment for the same activity in the same location, but it must be up to date.</p>

      <p class="govuk-body">You will need to carry out a new or updated assessment if:</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>the activity has changed in a way that could affect its impact on the water body</li>
        <li>the status or objectives of the water body have changed since the assessment was completed</li>
        <li>there is a new or increased risk that the water body will not meet its objectives</li>
        <li>the previous assessment does not contain enough detail to support your current application</li>
        <li>the assessment relates to an outdated river basin management plan cycle</li>
      </ul>

      <h3 class="govuk-heading-s">Getting a WFD assessment template</h3>

      <p class="govuk-body">If you need to provide a WFD assessment, you can use the following template. It's called a scoping document.</p>

      <p class="govuk-body"><a href="https://assets.publishing.service.gov.uk/media/6ab4e3b9fceb6fb3a650110e/wfd_scoping_template__1_.odt" class="govuk-link">Download the WFD assessment scoping document (ODT, 24KB)</a>.</p>

      <p class="govuk-body"><a href="https://www.gov.uk/guidance/water-framework-directive-assessment-estuarine-and-coastal-waters" class="govuk-link" rel="noreferrer noopener" target="_blank">Read the Environment Agency's guidance on the Water Framework Directive assessments for more information (opens in new tab)</a>.</p>

      <div class="govuk-button-group">
        {{ govukButton({
          text: "Continue",
          href: continueLink
        }) }}

        {{ appCancelButton({
          cancelLink: cancelLink
        }) }}
      </div>
    </div>
  </div>
{% endblock %}
