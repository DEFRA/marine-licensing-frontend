{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  {% set rows = [{
    key: { text: summary.withhold.key },
    value: { text: summary.withhold.value },
    actions: summary.withhold.actions
  }] %}

  {% if summary.approval %}
    {% set _ = rows.push({
      key: { text: summary.approval.key },
      value: { text: summary.approval.value },
      actions: summary.approval.actions
    }) %}
  {% endif %}

  {% if summary.reason %}
    {% set _ = rows.push({
      key: { text: summary.reason.key },
      value: { html: summary.reason.value | escape | nl2br },
      actions: summary.reason.actions
    }) %}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {{ govukSummaryList({
        rows: rows,
        attributes: { id: "public-register-check-answers" }
      }) }}

      <form method="POST">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}" />
        {{ govukButton({
          text: "Continue",
          attributes: { id: "continue" }
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
