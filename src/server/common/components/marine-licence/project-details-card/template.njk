{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "marine-licence/redaction-field/macro.njk" import appMarineLicenceRedactionField %}

{% set rows = [] %}

{% set rows = (rows.push({
  key: {
    text: "Project name"
  },
  value: {
    text: params.projectName
  },
  actions: {
    items: [
      {
        href: "/marine-licence/project-name?from=check-your-answers",
        text: "Change",
        visuallyHiddenText: "project name",
        classes: "govuk-link--no-visited-state"
      }
    ]
  } if not params.isReadOnly
} if params.projectName,{
  key: {
    text: "Project background"
  },
  value: {
    text: params.projectBackground
  },
  actions: {
    items: [
      {
        href: "/marine-licence/project-background?from=check-your-answers",
        text: "Change",
        visuallyHiddenText: "project background",
        classes: "govuk-link--no-visited-state"
      }
    ]
  } if not params.isReadOnly
},{
  key: {
    text: "Preferred start and end dates of the licence"
  },
  value: {
    html: appMarineLicenceRedactionField({
      fieldId: "preferredDates",
      label: "preferred start and end dates of the licence",
      originalText: params.preferredDates,
      redactions: params.redactions.preferredDates,
      publishedText: params.redactions.preferredDates.redactedText or params.preferredDates,
      isRedacted: params.redactions.preferredDates,
      saveUrl: params.redactionSaveUrl,
      csrfToken: params.csrfToken
    }),
    classes: "govuk-summary-list__value--full-width"
  } if params.enableRedaction else {
    text: params.preferredDates
  },
  actions: {
    items: [
      {
        href: "/marine-licence/start-and-end-dates?from=check-your-answers",
        text: "Change",
        visuallyHiddenText: "preferred dates",
        classes: "govuk-link--no-visited-state"
      }
    ]
  } if not params.isReadOnly
}), rows) %}


{{ govukSummaryList({
  card: {
    title: {
      text: "Project details"
    },
    attributes: {
      id: "project-details-card"
    }
  },
  rows: rows
}) }}
