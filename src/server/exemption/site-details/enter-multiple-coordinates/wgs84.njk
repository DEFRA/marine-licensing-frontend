{% extends "layouts/page.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "cancel-button/macro.njk" import appCancelButton %}

{% set detailsSummary %}Help with latitude and longitude formats{% endset %}
{% set detailsHTML %}
<p>Latitude and longitude can be written in different formats, including:</p>
<ul class="govuk-list govuk-list--bullet">
  <li>decimal degrees (DD) - 55.019889 or -1.399500</li>
  <li>degrees, minutes and seconds (DMS) - 55°01'11.6"N 1°23'58.2"WE</li>
  <li>degrees and decimal minutes (DMM) - 55° 1.19334', 1° 23.97'</li>
</ul>
<p>Enter coordinates in decimal degree (DD) format only.</p>
<p>Latitude ranges from -90 to 90, and longitude ranges from -180 to 180. Always enter latitude first, then longitude, in their separate fields.</p>
{% endset %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>
      <p>Enter in the decimal degree format. For example, 55.019889 or -1.399500.</p>
      
      {{ govukDetails({
        summaryText: detailsSummary,
        html: detailsHTML
      }) }}

      <form method="POST">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">

        <h2 class="govuk-heading-m">Coordinates</h2>

        {% call govukFieldset({
          legend: {
            text: "Start and end point",
            classes: "govuk-fieldset__legend--m",
            isPageHeading: false
          }
        }) %}
          {{ govukInput({
            id: "point1-latitude",
            name: "point1-latitude",
            value: payload["point1-latitude"] if payload,
            errorMessage: errors["point1-latitude"] if errors,
            label: {
              text: "Latitude",
              classes: "govuk-!-font-weight-bold"
            },
            classes: "govuk-!-width-one-half"
          }) }}
          {{ govukInput({
            id: "point1-longitude",
            name: "point1-longitude",
            value: payload["point1-longitude"] if payload,
            errorMessage: errors["point1-longitude"] if errors,
            label: {
              text: "Longitude",
              classes: "govuk-!-font-weight-bold"
            },
            classes: "govuk-!-width-one-half"
          }) }}
        {% endcall %}

        {% call govukFieldset({
          legend: {
            text: "Point 2",
            classes: "govuk-fieldset__legend--m",
            isPageHeading: false
          }
        }) %}
          {{ govukInput({
            id: "point2-latitude",
            name: "point2-latitude",
            value: payload["point2-latitude"] if payload,
            errorMessage: errors["point2-latitude"] if errors,
            label: {
              text: "Latitude",
              classes: "govuk-!-font-weight-bold"
            },
            classes: "govuk-!-width-one-half"
          }) }}
          {{ govukInput({
            id: "point2-longitude",
            name: "point2-longitude",
            value: payload["point2-longitude"] if payload,
            errorMessage: errors["point2-longitude"] if errors,
            label: {
              text: "Longitude",
              classes: "govuk-!-font-weight-bold"
            },
            classes: "govuk-!-width-one-half"
          }) }}
        {% endcall %}

        {% call govukFieldset({
          legend: {
            text: "Point 3",
            classes: "govuk-fieldset__legend--m",
            isPageHeading: false
          }
        }) %}
          {{ govukInput({
            id: "point3-latitude",
            name: "point3-latitude",
            value: payload["point3-latitude"] if payload,
            errorMessage: errors["point3-latitude"] if errors,
            label: {
              text: "Latitude",
              classes: "govuk-!-font-weight-bold"
            },
            classes: "govuk-!-width-one-half"
          }) }}
          {{ govukInput({
            id: "point3-longitude",
            name: "point3-longitude",
            value: payload["point3-longitude"] if payload,
            errorMessage: errors["point3-longitude"] if errors,
            label: {
              text: "Longitude",
              classes: "govuk-!-font-weight-bold"
            },
            classes: "govuk-!-width-one-half"
          }) }}
        {% endcall %}

        <div class="govuk-button-group govuk-!-margin-top-8">
          {{ govukButton({
            text: "Continue",
            attributes: {
              id: "continue"
            }
          }) }}
          {{ appCancelButton({
            cancelLink: "/exemption/task-list?cancel=site-details"
          }) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %}