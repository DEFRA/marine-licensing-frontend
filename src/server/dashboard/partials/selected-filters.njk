<div class="moj-filter__selected">

  <div class="moj-filter__selected-heading">

    <div class="moj-filter__heading-title">
      <h2 class="govuk-heading-m">Selected filters</h2>
    </div>

    <div class="moj-filter__heading-action">
      <p><a class="govuk-link govuk-link--no-visited-state" href="">Clear filters</a></p>
    </div>

  </div>

  {% for category in filterCategories %}
    <h3 class="govuk-heading-s govuk-!-margin-bottom-0">{{ category.heading.html | safe if category.heading.html else category.heading.text }}</h3>

    <ul class="moj-filter-tags">
      {% for item in category.items %}
        <li><a class="moj-filter__tag" href="#"{% if item.field %} data-field="{{ item.field }}"{% endif %}{% if item.value is defined %} data-value="{{ item.value }}"{% endif %}><span class="govuk-visually-hidden">Remove this filter</span> {{ item.text }}</a></li>
      {% endfor %}
    </ul>
  {% endfor %}

</div>
