{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "marine-licence/redaction-field/macro.njk" import appMarineLicenceRedactionField %}
{% from "marine-licence/withhold-document/macro.njk" import appMarineLicenceWithholdDocument %}

{% if params.waterFrameworkDirectiveData.nauticalMile %}
{% set rows = [] %}

{% set withholdDocument = params.redactions.waterFrameworkDirective.withholdDocument %}
{% set isFileWithheld = withholdDocument.withhold %}

{% set rows = (rows.push({
  key: params.waterFrameworkDirectiveData.nauticalMile.key,
  value: {
    html: appMarineLicenceRedactionField({
      fieldId: "waterFrameworkDirective-nauticalMile",
      marineLicenceId: params.marineLicenceId,
      fieldKey: "waterFrameworkDirective.nauticalMile",
      label: params.waterFrameworkDirectiveData.nauticalMile.key.text,
      originalText: params.waterFrameworkDirectiveData.nauticalMile.value.text,
      redaction: params.redactions.waterFrameworkDirective.nauticalMile,
      isRedacted: params.redactions.waterFrameworkDirective.nauticalMile,
      saveUrl: params.redactionSaveUrl,
      csrfToken: params.csrfToken
    }),
    classes: "govuk-summary-list__value--full-width"
  } if params.enableRedaction else params.waterFrameworkDirectiveData.nauticalMile.value
}), rows) %}

{% if params.waterFrameworkDirectiveData.excludedActivities %}
    {% set rows = (rows.push({
      key: params.waterFrameworkDirectiveData.excludedActivities.key,
      value: {
        html: appMarineLicenceRedactionField({
          fieldId: "waterFrameworkDirective-excludedActivities",
          marineLicenceId: params.marineLicenceId,
          fieldKey: "waterFrameworkDirective.excludedActivities",
          label: params.waterFrameworkDirectiveData.excludedActivities.key.text,
          originalText: params.waterFrameworkDirectiveData.excludedActivities.value.text,
          redaction: params.redactions.waterFrameworkDirective.excludedActivities,
          isRedacted: params.redactions.waterFrameworkDirective.excludedActivities,
          saveUrl: params.redactionSaveUrl,
          csrfToken: params.csrfToken
        }),
        classes: "govuk-summary-list__value--full-width"
      } if params.enableRedaction else params.waterFrameworkDirectiveData.excludedActivities.value
    }), rows) %}
{% endif %}

{% if params.waterFrameworkDirectiveData.uploadedFile %}
  {% if params.enableRedaction %}
    {% set rows = (rows.push({
      key: params.waterFrameworkDirectiveData.uploadedFile.key,
      value: {
        html: appMarineLicenceWithholdDocument({
          isWithheld: isFileWithheld,
          filename: params.waterFrameworkDirectiveData.uploadedFile.value.text,
          label: "the Water Framework Directive assessment",
          fieldKey: "waterFrameworkDirective.withholdDocument",
          redactedDocument: withholdDocument.redactedDocument,
          marineLicenceId: params.marineLicenceId,
          saveUrl: params.redactionSaveUrl,
          replaceDocumentUrl: params.replaceDocumentUrl + "?type=water-framework-directive",
          csrfToken: params.csrfToken
        }),
        classes: "govuk-summary-list__value--full-width"
      }
    }), rows) %}
  {% elif isFileWithheld %}
    {% set replacementFilename = withholdDocument.redactedDocument.filename %}
    {% set rows = (rows.push({
      key: params.waterFrameworkDirectiveData.uploadedFile.key,
      value: { text: replacementFilename } if replacementFilename else {
        html: "***REDACTED***" | wrapRedactionLabels
      }
    }), rows) %}
  {% else %}
    {% set rows = (rows.push(params.waterFrameworkDirectiveData.uploadedFile), rows) %}
  {% endif %}
{% endif %}

{% set cardAttributes = { id: "water-framework-directive-card" } %}
{% if params.enableRedaction and params.waterFrameworkDirectiveData.uploadedFile %}
  {% set cardAttributes = { id: "water-framework-directive-card", "data-module": "withhold-location" } %}
{% endif %}

{{ govukSummaryList({
  card: {
    title: {
      text: "Water Framework Directive assessment"
    },
    attributes: cardAttributes,
    actions: {
      items: [
        {
          href: params.changeLink ~ "?from=check-your-answers",
          text: "Change",
          visuallyHiddenText: " water framework directive assessment",
          classes: "govuk-link--no-visited-state"
        }
      ]
    } if not params.isReadOnly
  },
  rows: rows
}) }}
{% endif %}
