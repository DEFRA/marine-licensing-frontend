{% extends 'layouts/page.njk' %}

{% block pageTitle %}{{ heading }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}{% endblock %}

{% block footer %}{% endblock %}

{% block head %}
  {{ super() }}
  {% if isProcessing %}
    <meta http-equiv="refresh" content="{{ pageRefreshTimeInSeconds }}">
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-!-text-align-centre">
        <div class="app-loading-spinner" role="status">
          <span class="app-loading-spinner__text">Loading your Marine plan policies</span>
        </div>
        <h1 class="govuk-heading-l govuk-!-padding-top-6">{{ heading }}</h1>
        <p class="govuk-body">This usually takes less than 50 seconds.</p>
      </div>
    </div>
  </div>
{% endblock %}
