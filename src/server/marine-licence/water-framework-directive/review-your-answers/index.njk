{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}


{% set activityRows = [] %}

{% set activityRows = (activityRows.push({
  key: wfdDisplayData.nauticalMile.key,
  value: wfdDisplayData.nauticalMile.value,
  actions: {
    items: [
      {
        href: routes.MARINE_LICENCE_WATER_FRAMEWORK_DIRECTIVE_NAUTICAL_MILE + '?action=change',
        text: "Change",
        visuallyHiddenText: "nautical mile",
        classes: "govuk-link--no-visited-state"
      }
    ]
  }
}), activityRows) %}

{% set activityRows = (activityRows.push({
  key: wfdDisplayData.excludedActivities.key,
  value: wfdDisplayData.excludedActivities.value,
  actions: {
    items: [
      {
        href: routes.MARINE_LICENCE_WATER_FRAMEWORK_DIRECTIVE_EXCLUDED_ACTIVITIES + '?action=change',
        text: "Change",
        visuallyHiddenText: "excluded activities",
        classes: "govuk-link--no-visited-state"
      }
    ]
  }
}), activityRows) %}

{% if waterFrameworkDirective.uploadedFile %}

  {% set activityRows = (activityRows.push({
    key: wfdDisplayData.uploadedFile.key,
    value: wfdDisplayData.uploadedFile.value,
    actions: {
      items: [
        {
          href: routes.MARINE_LICENCE_WATER_FRAMEWORK_DIRECTIVE_FILE_UPLOAD + '?action=change',
          text: "Change",
          visuallyHiddenText: "upload a file",
          classes: "govuk-link--no-visited-state"
        }
      ]
    }
  }), activityRows) %}

{% endif %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {{ govukSummaryList({
        rows: activityRows,
        attributes: { id: 'water-framework-directive-review' }
      }) }}

      <form method="POST">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Continue",
            attributes: {
              id: "continue"
            }
          }) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %}
