    "minimatch": "10.2.4",
    "flatted": "^3.4.2",
    "picomatch": "^4.0.4",
    "postcss": "8.5.20",
    "vite": "^8.0.5",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "shell-quote": "^1.10.0",
    "cheerio": {
      "undici": "^7.28.0"
    },
    "jsdom": {
      "undici": "^7.28.0"
    },
    "hapi-pulse": {
      "joi": "^17.13.4"
    },
    "@hapi/bell": {
