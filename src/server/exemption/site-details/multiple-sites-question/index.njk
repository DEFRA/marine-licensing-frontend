{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "radio-page/macro.njk" import appRadioPage %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
{% endblock %}

{% block content %}

  {{ appRadioPage({
      name: "multipleSites",
      errorSummary: errorSummary,
      errors: errors,
      heading: heading,
      isPageHeading: true,
      value: payload.multipleSites,
      projectName: projectName,
      items: [
        {
          value: "yes",
          text: "Yes"
        },
        {
          value: "no", 
          text: "No"
        }
      ],
      csrfToken: csrfToken,
      cancelLink: "/exemption/task-list"
    })
  }}

{% endblock %} 