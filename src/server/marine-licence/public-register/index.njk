{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "radio-page/macro.njk" import appRadioPage %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}

  {% set personalInformationHelpHtml %}
    <p class="govuk-body">We publish the personal information we are required by law to publish. This includes the names and addresses of applicants, licence holders, agents and contractors. This is why we ask for it.</p>

    <p class="govuk-body">Only give personal information where we ask for it. Do not include personal information about yourself or anyone else anywhere else in your application or in your supporting documents. This includes names, contact details and signatures.</p>

    <p class="govuk-body">If you include personal information we have not asked for, a case officer will need to remove it before we publish your application. This may delay your decision.</p>
  {% endset -%}

  {% set publicRegisterContentHtml %}
    <p class="govuk-body">We are required by law to publish information about your application on the MMO’s public register. We publish your application and your supporting documents, including the personal information we are required by law to publish.</p>

    <p class="govuk-body">We do not publish the costs of your project, signatures, or administrative information we are not required to publish.</p>

    <p class="govuk-body">Most applications do not need anything withheld. We can only withhold information if publishing it would:</p>

    <ul class="govuk-list govuk-list--bullet">
      <li>compromise national security, or</li>
      <li>breach commercial or industrial confidentiality that is protected by law</li>
    </ul>

    <p class="govuk-body">We cannot withhold information for any other reason.</p>

    {{ govukDetails({
      summaryText: "Help with personal information in your application",
      html: personalInformationHelpHtml
    }) }}

    {{ govukWarningText({
      text: "You will need approval from the Secretary of State for Defence to withhold information on national security grounds."
    }) }}
  {% endset -%}

  {% set conditionalHtml %}
    {{ govukCharacterCount({
      id: "reason",
      name: "reason",
      maxlength: 1000,
      countType: "characters",
      label: {
        text: "Provide details of what you want withheld and why"
      },
      errorMessage: errors['withholdReason'],
      items: [
        {
          value: "nationalSecurity",
          text: withholdReasonLabels.nationalSecurity
        },
        {
          value: "commercialConfidentiality",
          text: withholdReasonLabels.commercialConfidentiality
        }
      ]
    }) }}
  {% endset -%}

  {{ appRadioPage({
    name: "withholdConsent",
    errorSummary: errorSummary,
    heading: heading,
    isPageHeading: true,
    value: payload.withholdConsent,
    errorMessage: errors['withholdConsent'],
    projectName: projectName,
    contentHtml: publicRegisterContentHtml,
    legend: "Do you want to ask us to withhold any information from the public register?",
    items: [
      {
        value: "yes",
        text: "Yes",
        conditional: {
          html: conditionalHtml
        }
      },
      {
        value: "no",
        text: "No"
      }
    ],
    csrfToken: csrfToken,
    cancelLink: backLink
  }) }}

{% endblock %}
