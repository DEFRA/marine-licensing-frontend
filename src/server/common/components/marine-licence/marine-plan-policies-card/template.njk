{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "marine-licence/policy-wording/macro.njk" import appMarineLicencePolicyWording %}
{% from "marine-licence/redaction-field/macro.njk" import appMarineLicenceRedactionField %}

{% if params.policies and params.policies.length %}
{% set rows = [] %}
{% for policy in params.policies %}
  {% set considerationValue %}
    <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">Policy information</p>
    {{ appMarineLicencePolicyWording({ html: policy.wording }) }}
    
    <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{% if params.isApplicant %}Your consideration{% else %}Applicant's consideration{% endif %}</p>

    {% if params.enableRedaction %}
      {{ appMarineLicenceRedactionField({
        fieldId: "marinePlanPolicyResponse-" + policy.policyCode,
        fieldKey: "marinePlanPolicyResponses",
        policyCode: policy.policyCode,
        label: "marine plan policy " + policy.policyCode + " consideration",
        originalText: policy.response,
        redaction: params.redactions.marinePlanPolicyResponses[policy.policyCode],
        isRedacted: params.redactions.marinePlanPolicyResponses[policy.policyCode],
        saveUrl: params.redactionSaveUrl,
        csrfToken: params.csrfToken
      }) }}
    {% else %}
      <p class="govuk-body govuk-!-margin-bottom-0">{{ policy.response }}</p>
    {% endif %}
  {% endset %}
  {% set rows = (rows.push({
    key: {
      text: policy.policyCode
    },
    value: {
      html: considerationValue
    },
    actions: {
      items: [
        {
          href: policy.changeHref,
          text: "Change",
          visuallyHiddenText: "marine plan policy " + policy.policyCode,
          classes: "govuk-link--no-visited-state"
        }
      ]
    } if not params.isReadOnly
  }), rows) %}
{% endfor %}

{{ govukSummaryList({
  card: {
    title: {
      text: "Marine plan policies"
    },
    attributes: {
      id: "marine-plan-policies-card"
    }
  },
  rows: rows
}) }}
{% endif %}
