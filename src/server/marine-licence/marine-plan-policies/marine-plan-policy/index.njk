{% extends 'layouts/page.njk' %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <h2 class="govuk-heading-m">Policy information</h2>
      <p class="govuk-body">{{ policyText }}</p>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ findOutMoreUrl }}" target="_blank" rel="noopener noreferrer">Find out more detailed information about this policy (opens in a new tab)</a>.
      </p>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ marinePlanPolicyGuidanceLink }}" target="_blank" rel="noopener noreferrer">Get help with completing the Marine plan policy section (opens in a new tab)</a>.
      </p>

      <form method="POST" novalidate>
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}" />

        {{ govukTextarea({
          id: "policyConsideration",
          name: "policyConsideration",
          rows: 8,
          label: {
            text: "Explain how you have considered this policy",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Enter a maximum of 2,000 characters"
          },
          errorMessage: errors['policyConsideration'],
          value: payload.policyConsideration
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save and continue",
            preventDoubleClick: true
          }) }}
        </div>
      </form>

    </div>
  </div>
{% endblock %}
