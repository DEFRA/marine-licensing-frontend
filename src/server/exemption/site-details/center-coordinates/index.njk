{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "cancel-button/macro.njk" import appCancelButton %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
{% endblock %}

{% set detailsHTML %}
  <p>Latitude and longitude can be written in different formats, including: </p>
  <ul class="govuk-list govuk-list--bullet">
      <li>decimal degrees (DD) - 55.019889 or -1.399500</li>
      <li>degrees, minutes and seconds (DMS) - 55°01'11.6"N 1°23'58.2"WE</li>
      <li>degrees and decimal minutes (DMM) - 55° 1.19334', 1° 23.97'</li>
  </ul>
  <p>Enter coordinates in decimal degree (DD) format only.</p>
  <p>Latitude ranges from -90 to 90, and longitude ranges from -180 to 180. Always enter latitude first, then longitude, in their separate fields.</p> 
{% endset %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <form method="POST" novalidate>
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">

        <span class="govuk-caption-l">{{ projectName }}</span>
        <h1 class="govuk-heading-l">{{ heading }}</h1>

        <p>Enter in the decimal degree format. For example, 55.019889 or -1.399500.</p>

        {{ govukDetails({
          summaryText: "Help with latitude and longitude formats",
          html: detailsHTML
        }) }}

        {{ govukInput({
          id: "latitude",
          name: "latitude",
          value: payload.latitude,
          label: {
            text: "Latitude"
          },
          classes: "govuk-!-width-one-half",
          errorMessage: errors["latitude"]
        }) }}

        {{ govukInput({
          id: "longitude",
          name: "longitude",
          value: payload.longitude,
          label: {
            text: "Longitude"
          },
          classes: "govuk-!-width-one-half",
          errorMessage: errors["longitude"]
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Continue",
            attributes: {
              id: "continue"
            }
          }) }}

          {{ appCancelButton({
            cancelLink: "/exemption/task-list?cancel=site-details"
          }) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %} 