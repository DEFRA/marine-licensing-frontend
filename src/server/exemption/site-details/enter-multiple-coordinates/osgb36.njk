{% extends "layouts/page.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "cancel-button/macro.njk" import appCancelButton %}
{% set detailsSummary %}Help with eastings and northings formats{% endset %}
{% set detailsHTML %}
<p>Eastings and northings use the Ordnance Survey National Grid reference system.</p>
<ul class="govuk-list govuk-list--bullet">
  <li>eastings - the distance east from the false origin in metres</li>
  <li>northings - the distance north from the false origin in metres</li>
</ul>
<p>Enter coordinates as a 6-digit easting and 6 or 7-digit northing. For example:</p>
<ul class="govuk-list govuk-list--bullet">
  <li>easting: 123456</li>
  <li>northing: 654321 or 1234567</li>
</ul>
<p>You can find grid references using the
  <a
    href="https://gridreferencefinder.ordnancesurvey.co.uk/"
    class="govuk-link"
    target="_blank"
    rel="noopener noreferrer">Ordnance Survey grid reference finder (opens in new tab)</a>.</p>
{% endset %}
{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
{% endblock %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>
      <p>Enter the easting and northing coordinates. For example, 123456 and 654321.</p>
      {{ govukDetails({
        summaryText: detailsSummary,
        html: detailsHTML
      }) }}
      <div data-module="moj-add-another">
        <h2 class="govuk-heading-m moj-add-another__heading" tabindex="-1">Coordinates</h2>
        <form method="POST" id="coordinate-form">
          <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
            {% for i in range(0, coordinateCount) %}
              {% set coordinate = coordinates[i] or { eastings: '', northings: '' } %}
              {% set pointNumber = i + 1 %}
              {% set showRemoveButton = i >= 3 %}
              {% set legendText %} Point {{ pointNumber }}
              {% endset %}
              {% call govukFieldset({
              classes: "moj-add-another__item",
              legend: {
                html: legendText,
                classes: "moj-add-another__title govuk-fieldset__legend--m",
                isPageHeading: false,
                attributes: {
                  style: "float: left;"
                }
              },
              attributes: {
                "data-point-index": i,
                "data-is-start-point": (i == 0)
              }
            }) %}
              {{ govukInput({
                id: "coordinates[" + i + "][eastings]",
                name: "coordinates[" + i + "][eastings]",
                value: coordinate.eastings,
                errorMessage: errors["coordinates" + i + "eastings"] if errors,
                label: {
                  text: "Eastings",
                  classes: "govuk-!-font-weight-bold"
                },
                classes: "govuk-!-width-one-half",
                attributes: {
                  "data-name": "coordinates[%index%][eastings]",
                  "data-id": "coordinates[%index%][eastings]"
                }
              }) }}
              {{ govukInput({
                id: "coordinates[" + i + "][northings]",
                name: "coordinates[" + i + "][northings]",
                value: coordinate.northings,
                errorMessage: errors["coordinates" + i + "northings"] if errors,
                label: {
                  text: "Northings",
                  classes: "govuk-!-font-weight-bold"
                },
                classes: "govuk-!-width-one-half",
                attributes: {
                  "data-name": "coordinates[%index%][northings]",
                  "data-id": "coordinates[%index%][northings]"
                }
              }) }}
              {% if showRemoveButton %}
                <a
                  href="?action=remove&pointIndex={{ i }}"
                  onclick="event.preventDefault(); submitWithAction('remove', {{ i }})"
                  class="govuk-button govuk-button--secondary remove-button govuk-!-margin-bottom-0 moj-add-another__remove-button">
                  Remove<span class="govuk-visually-hidden">
                    point {{ pointNumber }}</span>
                </a>
              {% endif %}
              {% endcall %}
            {% endfor %}
            <div class="moj-button-action">
              <a
                href="?action=add"
                onclick="event.preventDefault(); submitWithAction('add')"
                class="govuk-button govuk-button--secondary govuk-!-margin-bottom-4">
                Add another point
              </a>
            </div>
            <div class="govuk-button-group govuk-!-margin-top-8">
              {{ govukButton({
              text: "Continue",
              attributes: {
                id: "continue"
              }
            }) }}
              {{ appCancelButton({
              cancelLink: "/exemption/task-list?cancel=site-details"
            }) }}
            </div>
          </form>
        </div>
      </div>
    </div>
    <script>
      function submitWithAction(action, pointIndex) {
        const form = document.getElementById('coordinate-form');
        const formData = new FormData(form);
        // Build query string with current form data
        const params = new URLSearchParams();
        params.set('action', action);
        if (pointIndex !== undefined) {
          params.set('pointIndex', pointIndex);
        }
        // Add all form fields to query string
        for (const [key, value] of formData.entries()) {
          if (key !== 'csrfToken' && value.trim() !== '') {
            params.set(key, value);
          }
        }
        // Submit as GET request
        window.location.href = window.location.pathname + '?' + params.toString();
      }
    </script>
  {% endblock %}