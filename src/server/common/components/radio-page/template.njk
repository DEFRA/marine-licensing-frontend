{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "cancel-button/macro.njk" import appCancelButton %}

{% if params.buttonText is defined %}
    {% set buttonText = params.buttonText %}
{% else %}
    {% set buttonText = "Continue" %}
{% endif %}

{% set headingInLegend = params.isPageHeading and not params.contentHtml %}

{% set headingWithCaption %}
    {% if params.projectName %}
        <span class="govuk-caption-l">{{ params.projectName }}</span>
    {% endif %}
    {% if params.siteNumber %}
      <span class="govuk-caption-l">Site {{ params.siteNumber }}</span>
    {% endif %}
    <h1 class="govuk-heading-l govuk-!-margin-bottom-0">{{ params.heading }}</h1>
{% endset %}

{% if headingInLegend %}
    {% set fieldset = {
        legend: {
            html: headingWithCaption,
            classes: "govuk-fieldset__legend govuk-fieldset__legend--l govuk-!-margin-bottom-6"
        }
    } %}
{% elif params.contentHtml and params.legend %}
    {% set fieldset = {
        legend: {
            html: '<h2 class="govuk-fieldset__heading">' + (params.legend | escape) + '</h2>',
            classes: "govuk-fieldset__legend--m"
        }
    } %}
{% elif params.contentHtml %}
    {% set fieldset = {
        legend: {
            text: params.heading,
            classes: "govuk-visually-hidden"
        }
    } %}
{% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        {% if params.errorSummary %}
            {{ govukErrorSummary({
                titleText: "There is a problem",
                errorList: params.errorSummary
            }) }}
        {% endif %}

        {% if params.contentHtml %}
            {{ headingWithCaption | safe }}
            <div class="govuk-!-margin-top-6">
                {{ params.contentHtml | safe }}
            </div>
        {% elif not params.isPageHeading %}
            {% if params.projectName %}
                <span class="govuk-caption-l">{{ params.projectName }}</span>
            {% endif %}
            <h1 class="govuk-heading-l">{{ params.heading }}</h1>
        {% endif %}

        <form method="POST">

            <input type="hidden" name="csrfToken" value="{{params.csrfToken}}" />

            {{ govukRadios({
                idPrefix: params.name,
                name: params.name,
                value: params.value,
                fieldset: fieldset,
                hint: params.hint,
                errorMessage: params.errorMessage,
                items: params.items
            }) }}

            <div class="govuk-button-group">
                {{ govukButton({
                    text: buttonText,
                    classes: "govuk-button--primary"
                }) }}

                {{ appCancelButton({
                    cancelLink: params.cancelLink
                }) }}
            </div>

        </form>

    </div>
</div>
