{% extends "layouts/page.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "cancel-button/macro.njk" import appCancelButton %}
{% set detailsSummary %}Help with latitude and longitude formats{% endset %}
{% set detailsHTML %}
<p>Latitude and longitude can be written in different formats, including:</p>
<ul class="govuk-list govuk-list--bullet">
  <li>decimal degrees (DD) - 55.019889 or -1.399500</li>
  <li>degrees, minutes and seconds (DMS) - 55°01'11.6"N 1°23'58.2"WE</li>
  <li>degrees and decimal minutes (DMM) - 55° 1.19334', 1° 23.97'</li>
</ul>
<p>Enter coordinates in decimal degree (DD) format only.</p>
<p>Latitude ranges from -90 to 90, and longitude ranges from -180 to 180. Always enter latitude first, then longitude,
  in their separate fields.</p>
{% endset %}
{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
{% endblock %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}
      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>
      <p>Enter in the decimal degree format. For example, 55.019889 or -1.399500.</p>
      {{ govukDetails({
        summaryText: detailsSummary,
        html: detailsHTML
      }) }}
      <div data-module="moj-add-another">
        <h2 class="govuk-heading-m moj-add-another__heading" tabindex="-1">Coordinates</h2>
        <form method="POST" id="coordinate-form">
          <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
            {% for i in range(0, coordinateCount) %}
              {% set coordinate = coordinates[i] or { latitude: '', longitude: '' } %}
              {% set pointNumber = i + 1 %}
              {% set showRemoveButton = i >= 3 %}
              {% set legendText %} Point {{ pointNumber }}
              {% endset %}
              {% call govukFieldset({
              classes: "moj-add-another__item",
              legend: {
                html: legendText,
                classes: "moj-add-another__title govuk-fieldset__legend--m",
                isPageHeading: false,
                attributes: {
                  style: "float: left;"
                }
              },
              attributes: {
                "data-point-index": i,
                "data-is-start-point": (i == 0)
              }
            }) %}
              {{ govukInput({
                id: "coordinates[" + i + "][latitude]",
                name: "coordinates[" + i + "][latitude]",
                value: coordinate.latitude,
                errorMessage: errors["coordinates" + i + "latitude"] if errors,
                label: {
                  text: "Latitude",
                  classes: "govuk-!-font-weight-bold"
                },
                classes: "govuk-!-width-one-half",
                attributes: {
                  "data-name": "coordinates[%index%][latitude]",
                  "data-id": "coordinates[%index%][latitude]"
                }
              }) }}
              {{ govukInput({
                id: "coordinates[" + i + "][longitude]",
                name: "coordinates[" + i + "][longitude]",
                value: coordinate.longitude,
                errorMessage: errors["coordinates" + i + "longitude"] if errors,
                label: {
                  text: "Longitude",
                  classes: "govuk-!-font-weight-bold"
                },
                classes: "govuk-!-width-one-half",
                attributes: {
                  "data-name": "coordinates[%index%][longitude]",
                  "data-id": "coordinates[%index%][longitude]"
                }
              }) }}
              {% if showRemoveButton %}
                <a
                  href="?action=remove&pointIndex={{ i }}"
                  onclick="event.preventDefault(); submitWithAction('remove', {{ i }})"
                  class="govuk-button govuk-button--secondary remove-button govuk-!-margin-bottom-0 moj-add-another__remove-button">
                  Remove<span class="govuk-visually-hidden">
                    point {{ pointNumber }}</span>
                </a>
              {% endif %}
              {% endcall %}
            {% endfor %}
            <div class="moj-button-action">
              <a
                href="?action=add"
                onclick="event.preventDefault(); submitWithAction('add')"
                class="govuk-button govuk-button--secondary govuk-!-margin-bottom-4">
                Add another point
              </a>
            </div>
            <div class="govuk-button-group govuk-!-margin-top-8">
              {{ govukButton({
              text: "Continue",
              attributes: {
                id: "continue"
              }
            }) }}
              {{ appCancelButton({
              cancelLink: "/exemption/task-list?cancel=site-details"
            }) }}
            </div>
          </form>
        </div>
      </div>
    </div>
    <script>
      function submitWithAction(action, pointIndex) {
        const form = document.getElementById('coordinate-form');
        const formData = new FormData(form);
        // Build query string with current form data
        const params = new URLSearchParams();
        params.set('action', action);
        if (pointIndex !== undefined) {
          params.set('pointIndex', pointIndex);
        }
        // Add all form fields to query string
        for (const [key, value] of formData.entries()) {
          if (key !== 'csrfToken' && value.trim() !== '') {
            params.set(key, value);
          }
        }
        // Submit as GET request
        window.location.href = window.location.pathname + '?' + params.toString();
      }
    </script>
  {% endblock %}