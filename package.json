{
  "name": "marine-licensing-frontend",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "NODE_ENV=production webpack",
    "dev": "npm run frontend:watch & npm run server:watch",
    "dev:debug": "npm run frontend:watch & npm run server:debug",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "frontend:watch": "NODE_ENV=development webpack --watch",
    "lint": "npm run lint:js && npm run lint:scss",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint .",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "postversion": "git add package.json package-lock.json && git commit -m $npm_package_version",
    "test": "TZ=UTC vitest run --coverage",
    "test:ml": "TZ=UTC vitest run --config vitest.marine-licence.config.js",
    "test:ci": "CI=true TZ=UTC vitest run --coverage",
    "test:ci:shard": "CI=true TZ=UTC vitest run --coverage --reporter=blob --shard",
    "test:ci:merge": "CI=true TZ=UTC vitest run --merge-reports --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:watch:ml": "TZ=UTC vitest --config vitest.marine-licence.config.js",
    "test:integration:allure": "npx vitest run tests/ --coverage=false && npx allure generate allure-results --single-file --clean --name marine-licensing-dom-testing-library-tests",
    "server:watch": "node --watch --inspect=0.0.0.0 --env-file-if-exists=.env ./src",
    "server:debug": "node --watch --inspect-brk=0.0.0.0 --env-file-if-exists=.env ./src",
    "prestart": "npm run build",
    "start": "NODE_ENV=production node --use-strict .",
    "iat": "node scripts/iat-query.js",
    "audit": "audit-ci --config .audit-ci.jsonc",
    "knip": "knip"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/hapi-secure-context": "^0.4.0",
    "@defra/hapi-tracing": "^1.29.0",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@hapi/basic": "^7.0.2",
    "@hapi/bell": "^13.2.0",
    "@hapi/catbox-memory": "^6.0.2",
    "@hapi/catbox-redis": "^7.0.2",
    "@hapi/cookie": "^12.0.1",
    "@hapi/crumb": "^9.0.1",
    "@hapi/hapi": "^21.4.9",
    "@hapi/inert": "^7.1.2",
    "@hapi/jwt": "^3.2.4",
    "@hapi/vision": "^7.0.3",
    "@hapi/wreck": "^18.1.2",
    "@hapi/yar": "^11.0.3",
    "@microsoft/clarity": "^1.0.2",
    "@ministryofjustice/frontend": "^9.0.0",
    "accessible-autocomplete": "3.0.1",
    "aws-embedded-metrics": "^4.2.1",
    "chokidar": "3.6.0",
    "convict": "^6.2.5",
    "cssnano": "^9.1.1",
    "cssnano-preset-default": "^9.1.2",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "govuk-frontend": "6.1.0",
    "hapi-pino": "^13.0.0",
    "hapi-pulse": "^4.0.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "lodash": "^4.18.1",
    "nunjucks": "^3.2.4",
    "ol": "^10.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.1",
    "proj4": "^2.22.0",
    "rfc2047": "^4.0.1",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.6",
    "@faker-js/faker": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/runner": "^4.1.4",
    "@vitest/ui": "^4.1.10",
    "allure-commandline": "^2.46.1",
    "allure-vitest": "^3.13.0",
    "audit-ci": "7.1.0",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "cheerio": "^1.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.36.0",
    "jsdom": "^30.1.1",
    "knip": "^6.36.0",
    "neostandard": "^0.13.0",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.8",
    "sass-embedded": "^1.103.1",
    "sass-loader": "^17.0.0",
    "source-map-loader": "^5.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-gds": "^3.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "vitest-fetch-mock": "^0.4.5",
    "webpack": "^5.111.1",
    "webpack-assets-manifest": "6.5.2",
    "webpack-cli": "7.2.3"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.7",
    "colord": "^2.9.4",
    "js-yaml": "^4.3.2",
    "svgo": "^4.1.0",
    "moment": "^2.31.0",
    "source-map-js": "^1.2.2",
    "fast-copy": "^4.1.2",
    "smol-toml": "^1.9.0",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^5": "^5.0.12",
    "@hapi/bell": {
      "joi": "^17.13.8"
    },
    "@hapi/catbox-redis": {
      "joi": "^17.13.8"
    }
  }
}
