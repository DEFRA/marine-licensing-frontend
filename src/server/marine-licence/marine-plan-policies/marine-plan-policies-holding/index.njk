{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back to your project task list",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if projectName %}
        <span class="govuk-caption-l">{{projectName}}</span>
      {% endif %}
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <p class="govuk-body">Marine plan policies are taking longer than expected to load.
        <a href="{{ refreshLink }}" class="govuk-link">Refresh the page</a>
        to check if they are ready or come back and try again later</p>

    </div>
  </div>
{% endblock %}
