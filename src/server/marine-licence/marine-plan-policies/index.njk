{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back to your project task list",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if projectName %}
        <span class="govuk-caption-l">{{ projectName }}</span>
      {% endif %}
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <p class="govuk-body">The policies listed are based on the information you entered in Site and activity details.
        You must consider every policy listed before you can send your information. If you cannot finish now, you can
        return to this page later.</p>

      <p class="govuk-body">
        Before you start, read information on the policies presented here and how to complete this section in
        <a class="govuk-link" href="{{ marinePlanPolicyGuidanceLink }}" target="_blank" rel="noopener noreferrer">Marine plan policies guidance
          (opens in new tab)</a>.
      </p>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      <p class="govuk-body">{{ policiesCountText }}</p>

      {{ govukTaskList({
        idPrefix: "marine-plan-policies",
        items: policies
      }) }}

      {{ govukButton({
        text: "Continue",
        href: taskListLink
      }) }}
    </div>
  </div>
{% endblock %}
