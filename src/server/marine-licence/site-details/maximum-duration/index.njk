{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% set headingWithCaption %}
    {% if projectName %}
        <span class="govuk-caption-l">{{ projectName }}</span>
    {% endif %}
    {% if siteNumber and activityDetailsNumber %}
      <span class="govuk-caption-l">Site {{ siteNumber }} - Activity {{ activityDetailsNumber }}</span>
    {% endif %}
    <h1 class="govuk-fieldset__heading">{{ heading }}</h1>
{% endset %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <form method="POST">

        <input type="hidden" name="csrfToken" value="{{ csrfToken }}" />

        {{ govukDateInput({
          id: "duration",
          namePrefix: "duration",
          fieldset: {
            legend: {
              html: headingWithCaption,
              classes: "govuk-fieldset__legend govuk-fieldset__legend--l govuk-!-margin-bottom-6"
            }
          },
          hint: {
            text: "Enter 0 in any box that does not apply. For example, 2 years 0 months, or 0 years 6 months"
          },
          errorMessage: errors['duration-years'] or errors['duration-months'],
          items: [
            {
              id: "duration-years",
              name: "years",
              label:  "Years" ,
              classes: "govuk-input--width-2" + (" govuk-input--error" if errors['duration-years']),
              value: payload['duration-years']
            },
            {
              id: "duration-months",
              name: "months",
              label: "Months" ,
              classes: "govuk-input--width-2" + (" govuk-input--error" if errors['duration-months']),
              value: payload['duration-months']
            }
          ]
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save and continue",
            classes: "govuk-button--primary"
          }) }}
        </div>

      </form>

    </div>
  </div>

{% endblock %}
