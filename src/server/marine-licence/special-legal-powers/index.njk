{% extends 'layouts/page.njk' %}
{#{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "cancel-button/macro.njk" import appCancelButton %}#}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "radio-page/macro.njk" import appRadioPage %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  
  {% set noHtml %}
            {{ govukTextarea({
              id: "reason",
              name: "reason",
              label: {
                text: "Provide details of the legal powers including the relevant legislation"
              },
              errorMessage: errors['reason'],
              value: payload.reason
            }) }}
  {% endset -%}

  {{ appRadioPage({
            name: "fileUploadType",
            errorSummary: errorSummary,
            errors: errors,
            heading: "Does your organisation have special legal powers to do any of this project?",
            isPageHeading: true,
            value: payload.fileUploadType,
            errorMessage: errors['fileUploadType'],
            projectName: projectName,
            hint: { text: "You can either give permission to others to do the work, or do the work yourself without needing permission from other organisations, for example, if you're a harbour, lighthouse or coastal protection authority" },
            items: [
                {
                value: "yes",
                text: "Yes",
                conditional: {
                  html: noHtml
                }
                },
                {
                value: "no",
                text: "No"
                }
            ],
            csrfToken: csrfToken,
            buttonText: "Save and continue",
            cancelLink: backLink
            })
        }}

{% endblock %}
