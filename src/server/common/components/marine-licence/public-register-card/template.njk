{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "incomplete-field/macro.njk" import appIncompleteField %}

{% set rows = [] %}
{% for row in params.rows %}
  {% set _ = rows.push({
    key: row.key,
    value: { html: appIncompleteField({ text: "" }) } if row.isIncomplete else row.value,
    classes: row.classes
  }) %}
{% endfor %}

{{ govukSummaryList({
    card: {
      title: {
        text: "Information published on the public register"
      },
      actions: {
        items: [
          {
            href: params.changeLink,
            text: "Change",
            visuallyHiddenText: " information published on the public register",
            classes: "govuk-link--no-visited-state"
          }
        ]
      } if not params.isReadOnly,
      attributes: {
        id: "public-register-card"
      }
    },
    rows: rows
  }) }}
