{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "marine-licence/site-notice-evidence-card/macro.njk" import appMarineLicenceSiteNoticeEvidenceCard %}
{% from "incomplete-field/macro.njk" import appIncompleteField %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ pageCaption }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {% if evidenceSubmission %}
        {{ govukInsetText({
          text: "Evidence was resubmitted " + evidenceSubmission.resolvedAt + ((" by " + evidenceSubmission.resolvedByName) if evidenceSubmission.resolvedByName else "")
        }) }}
      {% endif %}

      <p class="govuk-body">We could not accept the photographs you provided for one or more locations. Even if only one photograph was rejected, you need to upload both photographs again for that location.</p>

      {% if not evidenceSubmission %}
        {% set evidenceWarning %}
          You must complete all sections marked {{ appIncompleteField() }} before you can send your evidence.
        {% endset %}

        {{ govukInsetText({
          html: evidenceWarning
        }) }}
      {% endif %}
    </div>

    <div class="govuk-grid-column-full">
      {% for location in locations %}
        {% set photoQuery = '?location=' ~ location.locationNumber %}

        {{ appMarineLicenceSiteNoticeEvidenceCard({
          evidenceIndex: location.locationNumber,
          locationName: location.locationName,
          dateDisplayed: location.dateDisplayed,
          rejectionReason: location.reason,
          closeUpPhoto: location.closeUpPhoto,
          closeUpPhotoHref: photoLinks.closeUpPhoto ~ photoQuery,
          positionPhoto: location.positionPhoto,
          positionPhotoHref: photoLinks.positionPhoto ~ photoQuery,
          cardAttributes: { id: 'site-location-' ~ location.locationNumber },
          evidenceSubmission: evidenceSubmission
        }) }}
      {% endfor %}
    </div>
  </div>

  {% if canSendEvidence %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <form method="POST" novalidate>
          <input type="hidden" name="csrfToken" value="{{ csrfToken }}" />

          {{ govukButton({
            text: "Send evidence",
            preventDoubleClick: true
          }) }}
        </form>
      </div>
    </div>
  {% endif %}
{% endblock %}
