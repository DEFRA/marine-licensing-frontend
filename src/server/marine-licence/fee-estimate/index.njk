{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "cancel-button/macro.njk" import appCancelButton %}

{% block beforeContent %}
{{ super() }}
<nav>
  {{ govukBackLink({
    text: "Back",
    href: backLink
  }) }}
</nav>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ projectName }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {{ govukInsetText({
        html: "Your application fee band: 2A<br>Your application fee will not exceed £1,400"
      }) }}

      <p class="govuk-body">Your final invoice will be based on actual hours worked. VAT does not apply.</p>

      <p class="govuk-body">If your application is approved, there could be an additional cost of up to £750 for post-consent monitoring.</p>

      <p class="govuk-body">Post-consent monitoring is the process of ensuring conditions are complied with after a marine licence is granted, which could involve an inspection.</p>

      <p class="govuk-body"><a href="{{ feesUrl }}" rel="noreferrer noopener" target="_blank">Find out more about MMO charges (opens in new tab)</a>.</p>

      <form method="POST">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}" />
        <input type="hidden" name="feeBand" value="2A" />

        <h2 class="govuk-heading-m">Terms and conditions</h2>

        <p class="govuk-body">You need to agree to these <a href="{{ feesTermsAndConditionsUrl }}" rel="noreferrer noopener" target="_blank">terms and conditions (opens in new tab)</a>.</p>

        {{ govukCheckboxes({
          name: "termsAndConditions",
          errorMessage: errors['termsAndConditions'],
          items: [
            {
              value: "true",
              text: "I agree to the terms and conditions",
              checked: payload.termsAndConditions
            }
          ]
        }) }}

        {{ govukRadios({
          name: "accept",
          errorMessage: errors['accept'],
          fieldset: {
            legend: {
              text: "Do you accept the fee estimate?",
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: "This includes the application fee of up to £1,400 and potential post-consent monitoring of up to £750"
          },
          value: payload.accept,
          items: [
            {
              value: "yes",
              text: "Yes"
            },
            {
              value: "no",
              text: "No"
            }
          ]
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save and continue",
            classes: "govuk-button--primary"
          }) }}

          {{ appCancelButton({
            cancelLink: cancelLink
          }) }}
          
        </div>
      </form>

    </div>
  </div>
{% endblock %}
